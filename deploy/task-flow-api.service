# Task Flow API(FastAPI) systemd 서비스
# 설치: sudo cp deploy/task-flow-api.service /etc/systemd/system/
#       sudo systemctl daemon-reload
# DB 접속 정보는 WorkingDirectory의 .env에서 앱이 직접 읽는다(이 파일에 비밀값을 넣지 않는다).
[Unit]
Description=Task Flow API (FastAPI/uvicorn)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=mzcedu
Group=mzcedu
WorkingDirectory=/home/mzcedu/vibe-lab/flow-task
ExecStart=/home/mzcedu/vibe-lab/flow-task/.venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
